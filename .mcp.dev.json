{
  "mcpServers": {
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GH_TOKEN}"
      }
    },
    "python-repl": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "repl-mcp",
        "--transport",
        "stdio"
      ]
    }
  }
}
