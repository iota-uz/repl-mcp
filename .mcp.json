{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GH_TOKEN}"
      }
    },
    "python-repl": {
      "command": "uv",
      "args": [
        "--directory",
        ".",
        "run",
        "repl-mcp",
        "--transport",
        "sse"
      ],
      "url": "http://localhost:8000/sse"
    }
  }
}
